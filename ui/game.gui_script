local model=require "simulation.expedition"
local save=require "services.save"
local clock=require "services.travel_clock"
local screens=require "ui.screens"
local input=require "ui.input"
local scene=require "presentation.scene"

local function feedback(self,arrival)
    if self.snapshot.settings.sound then sound.play(arrival and "#arrival" or "#decision") end
end

function init(self)
    msg.post(".","acquire_input_focus")
    self.snapshot,self.toast,self.save_blocked=save.load()
    self.snapshot=self.snapshot or model.new(1848)
    self.page="trail";self.speed=1;self.time=0;self.clock=clock.new()
    self.battle_actions={};self.battle_team={};self.has_focus=true
    self.combat_paused=true;self.combat_speed=1
    if self.snapshot.run.mode=="traveling" then model.command(self.snapshot,"pause") end
    self.reset_clock=function() clock.reset(self.clock) end
    self.toggle_combat=function()
        self.combat_paused=not self.combat_paused;self.reset_clock();self.redraw()
    end
    -- GUI deletion is deferred by Defold. Coalesce input/clock redraws so a
    -- burst of actions cannot allocate several complete screens in one frame.
    self.redraw=function() self.needs_redraw=true end
    self.save_now=function()
        if self.save_blocked then return end
        local ok,why=save.write(self.snapshot)
        self.save_error=not ok and why or nil
        if ok then self.toast="Journey saved locally" end
    end
    self.perform=function(id,args,destination)
        if self.save_blocked then return end
        local previous_mode=self.snapshot.run.mode
        local ok,why=model.command(self.snapshot,id,args)
        if ok then
            self.reset_clock()
            if id=="battle_start" then self.combat_paused=false;self.combat_log=nil end
            if id=="battle_step" then self.combat_log=nil;self.exchange_started=self.time end
            if self.snapshot.run.mode~="combat" then self.combat_paused=true end
            if id=="round" or id=="battle_start" or id=="new" then self.battle_actions={} end
            if id=="choice" or id=="new" then self.battle_team={} end
            if destination then self.page=destination end
            if self.snapshot.run.mode=="result" then self.page="trail" end
            self.save_now()
            if id~="step" or previous_mode~=self.snapshot.run.mode then feedback(self,self.snapshot.run.mode=="landmark" or self.snapshot.run.mode=="result") end
        else self.toast=why or "That choice is unavailable" end
        self.redraw()
    end
    self.open_page=function(destination)
        if self.save_blocked then return end
        if self.snapshot.run.mode=="combat" then self.combat_paused=true end
        if self.snapshot.run.mode=="traveling" then model.command(self.snapshot,"pause");self.save_now() end
        self.reset_clock();self.page=destination;self.redraw()
    end
    self.finish_edit=function()
        local edit=self.edit
        if not edit then return end
        local ok,why
        if edit.kind=="seed" then
            if edit.value=="" then self.toast="Enter a number first";self.redraw();return end
            ok,why=model.command(self.snapshot,"seed",{value=tonumber(edit.value)})
        else ok,why=model.command(self.snapshot,"rename",{member=edit.member,name=edit.value}) end
        if ok then self.edit=nil;self.save_now() else self.toast=why end
        self.redraw()
    end
    self.force_event=function(id)
        local ok,why=model.debug(self.snapshot,"event",id)
        if ok then self.page="trail";self.save_now() else self.toast=why end
        self.reset_clock();self.redraw()
    end
    self.debug_resupply=function()
        local ok,why=model.debug(self.snapshot,"resupply")
        if ok then self.save_now() else self.toast=why end
        self.redraw()
    end
    window.set_listener(function(_,event,data)
        if event==window.WINDOW_EVENT_FOCUS_LOST or event==window.WINDOW_EVENT_ICONIFIED then
            self.has_focus=false;self.reset_clock()
            if self.snapshot.run.mode=="combat" then self.combat_paused=true;self.redraw() end
            if self.snapshot.run.mode=="traveling" then model.command(self.snapshot,"pause");self.save_now();self.redraw() end
        elseif event==window.WINDOW_EVENT_FOCUS_GAINED or event==window.WINDOW_EVENT_DEICONIFIED then self.has_focus=true end
    end)
    self.save_now()
    self.redraw()
end

function update(self,dt)
    self.time=self.time+math.min(dt,0.1)
    local active=self.page=="trail" and self.snapshot.run.mode=="traveling" and not self.edit and not self.save_blocked and self.has_focus
    local fighting=self.page=="trail" and self.snapshot.run.mode=="combat" and model.combat.automatic(self.snapshot.run.battle) and not self.combat_paused and not self.edit and not self.save_blocked and not self.save_error and self.has_focus
    if fighting then
        if clock.tick(self.clock,dt,true,self.combat_speed==2 and 1.5 or 5) then self.perform("battle_step") end
    elseif clock.tick(self.clock,dt,active,self.speed==1 and 20 or 2.5) then self.perform("step") end
    if self.needs_redraw then self.needs_redraw=false;screens.draw(self) end
    scene.update(self,self.time,active,self.snapshot.settings.motion)
end

function on_input(self,action_id,action)
    return input.handle(self,action_id,action)
end

function final(self)
    self.save_now()
    window.set_listener(nil)
end
