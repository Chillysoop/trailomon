local model=require "simulation.expedition"
local screens=require "ui.screens"
local scene=require "presentation.scene"
local input=require "ui.input"

local function button(self,key)
    for _,b in ipairs(self.buttons) do if b.key==key then return b end end
    error("Missing button: "..key)
end

local function fixture(self,page,setup)
    self.snapshot=model.new(1848);self.page=page;self.speed=1;self.focus=1
    self.battle_team={};self.battle_actions={};self.edit=nil;self.save_blocked=false;self.symbol_group=1
    self.combat_paused=true;self.combat_speed=1;self.combat_log=nil
    if setup then setup(self.snapshot,self) end
    screens.draw(self)
    scene.update(self,0.2,true,true)
    for _,b in ipairs(self.buttons) do
        local pos,size=gui.get_position(b.node),gui.get_size(b.node)
        assert(pos.x-size.x/2>=0 and pos.x+size.x/2<=1280,"Button outside horizontal bounds: "..b.key)
        assert(pos.y-size.y/2>=0 and pos.y+size.y/2<=720,"Button outside vertical bounds: "..b.key)
    end
end
local function departed(p) assert(model.command(p,"depart")) end
local function landmark(n)
    return function(p) departed(p);p.run.target=n;p.run.progress=p.run.distance;p.run.mode="landmark" end
end
local function battle(p)
    departed(p);assert(model.debug(p,"event","scavengers"));assert(model.command(p,"choice",{id="battle"}));assert(model.command(p,"battle_start",{team={1,2}}))
end
local function interaction_checks(self)
    fixture(self,"trail");coroutine.yield()
    self.redraw=function() screens.draw(self) end
    self.perform=function(id,args,destination) assert(model.command(self.snapshot,id,args));self.page=destination or self.page;self.redraw() end
    local s=self.snapshot.run;local item=model.resources.goods.food;local food,coins=s.food,s.coins
    button(self,"buy_food").fn();coroutine.yield()
    assert(s.food==food+item.amount and s.coins==coins-item.price)
    button(self,"sell_food").fn();coroutine.yield()
    assert(s.food==food and s.coins==coins)
    s.food=model.resources.capacity(s)-model.resources.weight(s)+s.food;self.redraw();coroutine.yield()
    assert(not button(self,"buy_food").enabled and not button(self,"buy_medicine").enabled)
    assert(button(self,"sell_food").enabled)
    button(self,"sell_food").fn();coroutine.yield();assert(button(self,"buy_food").enabled)
    fixture(self,"trail",function(p)
        departed(p);p.run.food=0;for _,c in ipairs(p.run.crew) do c.stamina=0 end
        assert(model.debug(p,"event","scavengers"))
    end);coroutine.yield()
    self.redraw=function() screens.draw(self) end
    self.perform=function(id,args,destination) assert(model.command(self.snapshot,id,args));self.page=destination or self.page;self.redraw() end
    assert(not button(self,"event_food").enabled and not button(self,"event_battle").enabled)
    for i,b in ipairs(self.buttons) do if b.key=="event_withdraw" then self.focus=i end end
    input.handle(self,hash("confirm"),{pressed=true});coroutine.yield()
    assert(self.snapshot.run.mode=="stopped" and self.snapshot.run.cargo==92)
    fixture(self,"trail")
    self.redraw=function() screens.draw(self) end
    self.open_page=function(id) self.page=id;self.redraw() end
    coroutine.yield()
    for i,b in ipairs(self.buttons) do if b.key=="open_aims" then self.focus=i end end
    input.handle(self,hash("confirm"),{pressed=true});coroutine.yield()
    assert(self.page=="aims" and self.snapshot.run.mode=="preparation")
    button(self,"aims_back").fn();coroutine.yield();assert(self.page=="journal")
    button(self,"open_aims").fn();coroutine.yield();assert(self.page=="aims")
    fixture(self,"trail",function(p)
        departed(p);p.run.branches.last="ridge";model.finish(p,"delivered","Fixture arrival")
    end);coroutine.yield()
    button(self,"open_aims").fn();coroutine.yield()
    assert(self.page=="aims" and self.snapshot.profile.aims.completed.peaceful==1)
    fixture(self,"work_items")
    coroutine.yield()
    self.redraw=function() screens.draw(self) end
    self.perform=function(id,args,destination) assert(model.command(self.snapshot,id,args));self.page=destination or self.page;self.redraw() end
    self.open_page=function(id) self.page=id;self.redraw() end
    for i,b in ipairs(self.buttons) do if b.key=="item_padded_trace" then self.focus=i end end
    input.handle(self,hash("confirm"),{pressed=true});coroutine.yield()
    button(self,"item_padded_trace").fn();coroutine.yield()
    assert(self.snapshot.run.crew[1].work_item=="padded_trace")
    button(self,"item_member2").fn();coroutine.yield()
    button(self,"item_padded_trace").fn();coroutine.yield()
    assert(not self.snapshot.run.crew[1].work_item and self.snapshot.run.crew[2].work_item=="padded_trace")
    button(self,"return_padded_trace").fn();coroutine.yield()
    assert(not self.snapshot.run.crew[2].work_item and self.snapshot.run.coins==50)
    button(self,"items_back").fn();coroutine.yield()
    assert(self.page=="crew")
    button(self,"open_items").fn();coroutine.yield()
    assert(self.page=="work_items")
    for _,target in ipairs({2,5}) do
        for index=1,2 do
            fixture(self,"trail",landmark(target));coroutine.yield()
            local path=model.trail_reports.get(self.snapshot.run).routes[index]
            for i,b in ipairs(self.buttons) do if b.key==path.label then self.focus=i end end
            input.handle(self,hash("confirm"),{pressed=true});coroutine.yield()
            assert(self.snapshot.run.mode=="traveling" and self.snapshot.run.terrain==path.id and self.snapshot.run.distance==path.distance)
        end
    end
    fixture(self,"trail",landmark(2));coroutine.yield()
    button(self,"report_crew").fn();coroutine.yield()
    assert(self.page=="crew" and self.snapshot.run.day==1)
    self.open_page("trail");coroutine.yield()
    button(self,"Rest beneath the oak").fn();coroutine.yield()
    assert(self.snapshot.run.day==2 and self.snapshot.run.mode=="landmark")
    fixture(self,"trail",landmark(5));coroutine.yield()
    button(self,"Prepare for the last stretch").fn();coroutine.yield()
    assert(self.page=="camp" and self.snapshot.run.day==1)
    fixture(self,"trail",function(p)
        departed(p);p.run.target=3;p.run.terrain="woodland";p.run.progress=p.run.distance-1
        assert(model.debug(p,"event","tree"))
    end);coroutine.yield()
    button(self,"event_haul").fn();coroutine.yield()
    button(self,"Follow the road").fn();coroutine.yield()
    self.perform("step");coroutine.yield()
    assert(self.snapshot.run.road_story and self.snapshot.run.mode=="landmark")
    local food=self.snapshot.run.food;local day=self.snapshot.run.day
    for i,b in ipairs(self.buttons) do if b.key=="story_continue" then self.focus=i end end
    input.handle(self,hash("confirm"),{pressed=true});coroutine.yield()
    assert(not self.snapshot.run.road_story and self.snapshot.run.food==food and self.snapshot.run.day==day)
    assert(button(self,"Visit the supply counter"))
    fixture(self,"settings",departed)
    coroutine.yield()
    local seed=button(self,"settings_seed")
    local pos,size=gui.get_position(seed.node),gui.get_size(seed.node)
    assert(pos.y-size.y/2-14>=140,"Final settings detail overlaps the road notes")
    fixture(self,"journal",departed)
    coroutine.yield()
    self.redraw=function() screens.draw(self) end
    self.open_page=function(id) self.page=id;self.redraw() end
    button(self,"symbol_guide").fn()
    coroutine.yield()
    assert(self.page=="symbols")
    button(self,"symbol_group3").fn()
    coroutine.yield()
    assert(self.symbol_group==3)
    button(self,"symbols_back").fn()
    coroutine.yield()
    assert(self.page=="journal")
    fixture(self,"camp",departed)
    coroutine.yield()
    button(self,"gather_preview").fn()
    coroutine.yield()
    assert(self.page=="forage" and button(self,"gather_confirm").enabled)
    self.perform=function(id,args,destination) assert(model.command(self.snapshot,id,args));self.page=destination or self.page;self.redraw() end
    local day=self.snapshot.run.day
    button(self,"gather_confirm").fn()
    coroutine.yield()
    assert(self.page=="camp" and self.snapshot.run.day==day+1)
    fixture(self,"trail",battle)
    coroutine.yield()
    self.redraw=function() screens.draw(self) end
    self.perform=function(id,args) assert(model.command(self.snapshot,id,args));self.combat_log=nil;self.redraw() end
    self.toggle_combat=function() self.combat_paused=not self.combat_paused;self.redraw() end
    assert(button(self,"combat_step").enabled)
    input.handle(self,hash("pause"),{pressed=true})
    coroutine.yield()
    assert(not self.combat_paused,"Space must resume automatic combat")
    button(self,"combat_pause").fn()
    coroutine.yield()
    assert(self.combat_paused)
    button(self,"combat_step").fn()
    coroutine.yield()
    assert(#self.snapshot.run.battle.history==1 and self.combat_paused)
    button(self,"combat_speed").fn()
    coroutine.yield()
    assert(self.combat_speed==2)
    button(self,"battle_withdraw").fn()
    coroutine.yield()
    assert(self.snapshot.run.mode=="combat_result")
    button(self,"combat_continue").fn()
    assert(self.snapshot.run.mode=="stopped")

    fixture(self,"trail",function(p) departed(p);model.debug(p,"event","scavengers");model.command(p,"choice",{id="battle"}) end)
    coroutine.yield()
    button(self,"battle_back").fn()
    coroutine.yield()
    assert(self.snapshot.run.mode=="event")
    button(self,"event_battle").fn()
    coroutine.yield()
    assert(not button(self,"battle_begin").enabled)
    button(self,"battler1").fn()
    coroutine.yield()
    assert(button(self,"battle_begin").enabled)
    button(self,"battler2").fn()
    coroutine.yield()
    button(self,"swap_positions").fn()
    coroutine.yield()
    assert(self.battle_team[1]==2 and self.battle_team[2]==1)
    button(self,"battle_begin").fn()
    coroutine.yield()
    assert(self.snapshot.run.battle.team[1]==2)
    button(self,"battle_back").fn()
    coroutine.yield()
    assert(self.snapshot.run.mode=="event")

    fixture(self,"trail",departed)
    coroutine.yield()
    button(self,"travel_speed").fn()
    coroutine.yield()
    assert(self.snapshot.settings.travel_speed==2)

    fixture(self,"trail",function(p,ui) ui.edit={kind="seed",value="1848"} end)
    coroutine.yield()
    local calls=0
    self.perform=function() calls=calls+1 end
    self.open_page=function() calls=calls+1 end
    self.finish_edit=function() calls=calls+1 end
    input.handle(self,hash("pause"),{pressed=true})
    input.handle(self,hash("debug"),{pressed=true})
    assert(calls==0 and self.edit,"Dialog leaked a global shortcut")
    input.handle(self,hash("next"),{pressed=true})
    assert(self.buttons[self.focus].key=="Cancel")
    assert(gui.is_enabled(self.buttons[self.focus].focus_mark))
    self.redraw()
    coroutine.yield()
    assert(self.buttons[self.focus].key=="Cancel" and gui.is_enabled(self.buttons[self.focus].focus_mark),"Focus disappeared on redraw")
    input.handle(self,hash("confirm"),{pressed=true})
    coroutine.yield()
    assert(not self.edit and calls==0,"Enter did not activate the focused Cancel button")

    self.edit={kind="seed",value="12"};self.redraw()
    coroutine.yield()
    input.handle(self,hash("text"),{text="3a"})
    coroutine.yield()
    assert(self.edit.value=="123")
    input.handle(self,hash("erase"),{pressed=true})
    coroutine.yield()
    assert(self.edit.value=="12")
    input.handle(self,hash("back"),{pressed=true})
    assert(not self.edit)
end
function init(self)
    local noop=function() end
    self.perform=noop;self.open_page=noop;self.redraw=noop;self.reset_clock=noop;self.save_now=noop
    self.force_event=noop;self.debug_resupply=noop;self.finish_edit=noop
    self.cases={
        {"trail"},{"trail",departed},{"crew",departed},{"companion",departed},
        {"map",departed},{"journal",departed},{"settings",departed},{"camp",departed},
        {"return",departed},{"debug",departed},
        {"trail",function(p) departed(p);assert(model.debug(p,"event","mud")) end},
        {"trail",function(p)
            departed(p);local progression=require "simulation.progression"
            p.run.crew={progression.companion("brindlehorn"),progression.companion("cindercoil"),progression.companion("slatewhorl")}
            p.run.weather="rain";p.run.terrain="ridge";p.run.day=18
            assert(model.debug(p,"event","territorial"))
        end},
        {"trail",landmark(2)},{"trail",landmark(3)},{"shop",landmark(3)},
        {"trail",landmark(4)},
        {"trail",function(p) landmark(4)(p);assert(model.command(p,"river",{method="inspect"})) end},
        {"trail",function(p) landmark(4)(p);assert(model.command(p,"river",{method="ferry"})) end},
        {"trail",landmark(5)},
        {"trail",function(p) departed(p);assert(model.debug(p,"event","scavengers"));assert(model.command(p,"choice",{id="battle"})) end},
        {"trail",battle},
        {"trail",function(p) battle(p);p.run.pending=nil;p.run.return_rng=nil;assert(require("simulation.combat_manual").start(p.run,"scavengers",{1,2})) end},
        {"trail",function(p,ui) battle(p);assert(model.command(p,"withdraw")) end},
        {"trail",function(p) departed(p);assert(model.command(p,"return")) end},
        {"journal",function(p,ui) departed(p);assert(model.command(p,"return"));ui.journal_history=true end},
        {"trail",function(p,ui) ui.edit={kind="seed",value="1848"} end},
        {"trail",function(p,ui) ui.save_blocked=true end},
        {"symbols",departed},
        {"symbols",function(p,ui) departed(p);ui.symbol_group=2 end},
        {"symbols",function(p,ui) departed(p);ui.symbol_group=3 end},
        {"forage",departed},
        {"forage",function(p) departed(p);p.run.food=119 end},
        {"forage",function(p) departed(p);p.run.forage[tostring(p.run.target)]=10 end},
        {"forage",function(p) departed(p);p.run.day=31 end},
        {"trail",function(p) departed(p);assert(model.debug(p,"event","cinder_return"));p.run.food=70 end},
        {"trail",function(p) departed(p);assert(model.debug(p,"event","slate_return"));p.run.rations="generous" end},
    }
end
function on_message(self,id,message,sender)
    if id==hash("start_checks") then self.index=1 end
end
function update(self,dt)
    if self.interactions then
        local ok,why=coroutine.resume(self.interactions)
        if not ok or coroutine.status(self.interactions)=="dead" then
            local report=assert(io.open(sys.get_config_string("trailomon.check_report","engine-check-report.txt"),"a"))
            report:write(ok and "PASS: battle readiness, automatic steps, positions, result acknowledgement, modal keyboard routing, editing, and persistent focus.\n" or "FAIL: interaction checks / "..tostring(why).."\n")
            report:close();self.interactions=nil
            msg.post("@system:","exit",{code=ok and 0 or 1})
        end
        return
    end
    if not self.index then return end
    local case=self.cases[self.index]
    local ok,why=pcall(fixture,self,case[1],case[2])
    if not ok or self.index==#self.cases then
        local report=assert(io.open(sys.get_config_string("trailomon.check_report","engine-check-report.txt"),"a"))
        report:write(ok and "PASS: 36 native GUI states, icon rendering, scene motion, and button bounds.\n" or "FAIL: GUI case "..self.index.." / "..tostring(why).."\n")
        report:close();self.index=nil
        if ok then self.interactions=coroutine.create(function() interaction_checks(self) end)
        else msg.post("@system:","exit",{code=1}) end
    else self.index=self.index+1 end
end
