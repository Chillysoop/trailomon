local model=require "simulation.expedition"
local save=require "services.save"

local function run()
    require("tests.ambush_native").persistence()
    assert(screenshot==nil,"Capture extension leaked into the ordinary game test engine")
    local primary,backup=save.paths()
    -- Refuse to touch anything until the isolated namespace has been verified.
    local namespace=sys.get_config_string("trailomon.save_namespace","")
    assert(namespace=="trailomon_automated_checks" or namespace:match("^trailomon_qa_[a-z]+_%d+$"))
    assert(primary:find(namespace,1,true) and backup:find(namespace,1,true))
    os.remove(sys.get_save_file(namespace,"depot_selection"))
    local p=model.new(1848)
    p.run.combat_effort=nil -- Existing journeys retain original 4/8 costs.
    p.settings.travel_speed=nil -- A pre-J4 native save remains readable.
    assert(model.command(p,"depart"))
    assert(model.debug(p,"event","shortcut"))
    local roll=p.run.pending.roll
    assert(save.write(p))
    local loaded=assert(save.load())
    assert(loaded.run.pending.id=="shortcut" and loaded.run.pending.roll==roll)
    assert(loaded.settings.travel_speed==nil)
    assert(loaded.run.combat_effort==nil and model.combat.costs(loaded.run)==4)
    assert(model.command(loaded,"settings",{key="travel_speed"}))
    assert(save.write(loaded))
    loaded=assert(save.load());assert(loaded.settings.travel_speed==2)
    assert(model.command(loaded,"choice",{id="risk"}))
    assert(save.write(loaded))
    local file=assert(io.open(primary,"wb"));file:write("corrupt");file:close()
    local recovered,notice=save.load()
    assert(recovered and notice and recovered.run.pending.id=="shortcut")
    assert(save.write(recovered))
    assert(model.command(recovered,"choice",{id="road"}))
    assert(model.debug(recovered,"event","scavengers"))
    assert(model.command(recovered,"choice",{id="battle"}))
    assert(model.command(recovered,"battle_start",{team={1,2}}))
    local target=recovered.run.battle.intent.target
    assert(save.write(recovered))
    local battle=assert(save.load())
    assert(battle.run.battle.intent.target==target and battle.run.battle.round==1)
    assert(battle.run.battle.effort==nil and model.combat.costs(battle.run)==4)
    local event_roll=battle.run.pending.roll
    assert(model.command(battle,"battle_back"))
    assert(save.write(battle))
    battle=assert(save.load())
    assert(battle.run.mode=="event" and battle.run.pending.roll==event_roll)
    assert(model.command(battle,"choice",{id="battle"}))
    assert(model.command(battle,"battle_start",{team={1,2}}))
    assert(battle.run.battle.intent.target==target)
    assert(model.command(battle,"battle_step"))
    assert(save.write(battle))
    battle=assert(save.load())
    assert(#battle.run.battle.history==1)
    assert(model.command(battle,"withdraw"))
    assert(save.write(battle))
    battle=assert(save.load())
    assert(battle.run.mode=="combat_result" and battle.run.battle.result)
    assert(model.command(battle,"battle_continue"))
    assert(model.command(battle,"return"))
    assert(save.write(battle))
    local ended=assert(save.load())
    assert(ended.run.mode=="result" and #ended.profile.history==1)
    assert(not model.command(ended,"return"))
    local guardian=model.new(1848);assert(model.command(guardian,"depart"))
    assert(model.debug(guardian,"event","territorial"))
    assert(model.command(guardian,"choice",{id="battle"}))
    assert(save.write(guardian));guardian=assert(save.load())
    assert(guardian.run.pending.pattern==nil and guardian.run.combat_effort==model.combat.EFFORT)
    assert(model.command(guardian,"battle_start",{team={1,2}}))
    while guardian.run.mode=="combat" do
        assert(save.write(guardian));guardian=assert(save.load())
        assert(guardian.run.battle.pattern==model.combat.GUARDIAN_PATTERN)
        assert(guardian.run.battle.effort==model.combat.EFFORT and model.combat.costs(guardian.run)==3)
        assert(model.command(guardian,"battle_step"))
    end
    assert(save.write(guardian));guardian=assert(save.load())
    assert(guardian.run.mode=="combat_result")
    local equipped=model.new(1848)
    assert(model.command(equipped,"buy_work_item",{item="padded_trace"}))
    assert(model.command(equipped,"equip_work_item",{member=1,item="padded_trace"}))
    assert(save.write(equipped));equipped=assert(save.load())
    assert(equipped.run.work_items.padded_trace and equipped.run.crew[1].work_item=="padded_trace")
    assert(model.command(equipped,"depart"));assert(model.debug(equipped,"event","territorial"))
    assert(model.command(equipped,"choice",{id="battle"}));assert(model.command(equipped,"battle_start",{team={1,2}}))
    for _=1,3 do assert(model.command(equipped,"battle_step")) end
    assert(equipped.run.battle.item_used.padded_trace)
    assert(save.write(equipped));equipped=assert(save.load())
    assert(equipped.run.battle.item_used.padded_trace and equipped.run.crew[1].condition==100)
    assert(model.command(equipped,"battle_step"));assert(save.write(equipped))
    equipped=assert(save.load());assert(equipped.run.mode=="combat_result")
    for _,id in ipairs({"tree","axle"}) do
        local p=model.new(1848);assert(model.command(p,"depart"))
        p.run.target=3;p.run.terrain="woodland";p.run.progress=p.run.distance-1
        assert(model.debug(p,"event",id));assert(model.command(p,"choice",{id=id=="tree" and "haul" or "risk"}))
        assert(save.write(p));p=assert(save.load())
        assert(p.run.flags[id=="tree" and "road_cleared" or "axle_lashed"])
        assert(model.command(p,"resume"));assert(model.command(p,"step"));assert(p.run.road_story)
        local story=p.run.road_story;local food=p.run.food;local wagon=p.run.wagon
        assert(save.write(p));p=assert(save.load());assert(p.run.road_story==story)
        assert(model.command(p,"ack_story"));assert(save.write(p));p=assert(save.load())
        assert(not p.run.road_story and p.run.food==food and p.run.wagon==wagon)
    end
    -- Goals survive native serialization, including a spent peaceful attempt.
    local goals=model.new(1848);assert(model.command(goals,"depart"))
    assert(save.write(goals));goals=assert(save.load())
    assert(goals.run.aim_journey.pair=="brindlehorn+loamling" and not goals.run.aim_journey.fought)
    assert(model.debug(goals,"event","scavengers"));assert(model.command(goals,"choice",{id="battle"}))
    assert(model.command(goals,"battle_start",{team={1,2}}));assert(model.command(goals,"battle_step"))
    assert(save.write(goals));goals=assert(save.load());assert(goals.run.aim_journey.fought)
    goals.run.branches.last="ridge";assert(model.finish(goals,"delivered","Fixture arrival"))
    assert(save.write(goals));goals=assert(save.load())
    assert(goals.profile.aims.paths.ridge==1 and not goals.profile.aims.completed.peaceful)
    assert(model.command(goals,"new"));assert(model.command(goals,"crew",{species="loamling"}))
    assert(model.command(goals,"crew",{species="bellmoth"}));assert(model.command(goals,"depart"))
    goals.run.branches.last="gorge";assert(model.finish(goals,"delivered","Fixture arrival"))
    assert(save.write(goals));goals=assert(save.load())
    for _,id in ipairs({"company","paths","peaceful"}) do assert(goals.profile.aims.completed[id]==2) end
    assert(not model.finish(goals,"delivered","Duplicate"));assert(model.command(goals,"new"))
    assert(save.write(goals));goals=assert(save.load())
    assert(goals.profile.aims.completed.company==2 and not goals.run.aim_journey)
    local practice=model.new(1848);assert(model.command(practice,"depart"));practice.run.target=3;practice.run.progress=practice.run.distance;practice.run.mode="landmark"
    assert(model.command(practice,"courier"));assert(model.command(practice,"choice",{id="battle"}));assert(model.command(practice,"battle_start",{team={1,2}}))
    while practice.run.mode=="combat" do assert(save.write(practice));practice=assert(save.load());assert(model.command(practice,"battle_step")) end
    assert(save.write(practice));practice=assert(save.load());assert(practice.run.battle.practice>0 and practice.run.cargo==100)
    assert(model.command(practice,"battle_continue"));assert(practice.run.mode=="landmark");assert(model.command(practice,"return"));assert(save.write(practice));practice=assert(save.load());assert(practice.profile.courier.sparred)
    local wild=model.new(1848);assert(model.command(wild,"depart"));assert(model.debug(wild,"event","wild_brindlehorn"))
    assert(model.command(wild,"choice",{id="watch"}));assert(save.write(wild));wild=assert(save.load())
    assert(wild.run.observations.brindlehorn);assert(model.command(wild,"return"));assert(save.write(wild));wild=assert(save.load())
    assert(wild.profile.observations.brindlehorn and wild.profile.traveled.brindlehorn and wild.run.new_observations.brindlehorn)
    local tracks=model.new(11);assert(model.command(tracks,"depart"))
    local clue=tracks.run.tracks['2'];local clue_event,clue_roll=clue.event,clue.roll
    assert(save.write(tracks));tracks=assert(save.load())
    assert(tracks.run.tracks['2'].event==clue_event and tracks.run.tracks['2'].roll==clue_roll)
    assert(model.command(tracks,"follow_tracks"));assert(save.write(tracks));tracks=assert(save.load())
    assert(tracks.run.tracks['2'].used and not require("simulation.tracking").preview(tracks).available)
    local closure=model.new(1848);assert(model.command(closure,"depart"))
    closure.run.day=31;closure.run.target=6;closure.run.distance=35;closure.run.progress=34.5
    assert(model.command(closure,"resume"));assert(model.command(closure,"step"))
    assert(closure.run.outcome=="rescued" and closure.run.progress==35)
    assert(save.write(closure));closure=assert(save.load())
    assert(closure.run.mode=="result" and closure.profile.last_committed==closure.run.id)
    -- Both slots live inside the already-verified automated namespace.
    local dp,db=save.paths("discovery");os.remove(dp);os.remove(db)
    local original=closure
    local discovery=assert(save.select(original,"discovery"))
    assert(discovery.profile.start_mode=="discovery" and #discovery.run.crew==1)
    assert(model.command(discovery,"starter",{species="reedskipper"}));assert(model.command(discovery,"depart"))
    for _=1,3 do assert(model.advance_day(discovery,true,false)) end
    assert(discovery.run.crew[1].habit_days==3)
    assert(model.command(discovery,"return"));assert(model.command(discovery,"new"));assert(model.command(discovery,"habit",{species="reedskipper"}))
    assert(save.write(discovery));local check=assert(save.load());assert(check.run.crew[1].habit)
    package.loaded["services.save"]=nil
    local restarted=require "services.save";local resumed=assert(restarted.load())
    assert(restarted.slot()=="discovery" and resumed.run.crew[1].habit)
    local classic=assert(save.select(discovery,"classic"));assert(classic.run.seed==original.run.seed and classic.run.outcome==original.run.outcome)
    assert(classic.run.day==original.run.day and classic.profile.last_committed==original.profile.last_committed)
    local again=assert(save.select(classic,"discovery"));assert(again.run.crew[1].species=="reedskipper" and again.run.crew[1].habit)
    assert(model.command(again,"depart"));again.run.mode="landmark";again.run.progress=again.run.distance
    again.run.seen.courier_intro=true;again.run.seen.discover_loamling=true
    assert(model.command(again,"meet_wild"));assert(save.write(again));again=assert(save.load())
    assert(again.run.pending.id=="meet_brindlehorn");assert(model.command(again,"choice",{id="invite"}))
    assert(model.command(again,"return"));assert(save.write(again));again=assert(save.load());assert(again.profile.roster.brindlehorn)
    assert(save.select(again,"classic"));os.remove(dp);os.remove(db);os.remove(sys.get_save_file(namespace,"depot_selection"))
    package.loaded["services.save"]=save
    for _,path in ipairs({primary,backup}) do
        local f=assert(io.open(path,"wb"));f:write("corrupt");f:close()
    end
    local invalid,warning,blocked=save.load()
    assert(not invalid and warning and blocked)
    os.remove(primary);os.remove(backup)
end
function init(self)
    local ok,why=pcall(run)
    local fixture=sys.get_config_string("trailomon.fixture","")
    if ok and fixture~="" then
        ok,why=pcall(function()
            assert(sys.get_config_string("trailomon.save_namespace",""):match("^trailomon_qa_"),"Fixtures require a separate QA save namespace")
            local p=model.new(1848);assert(model.command(p,"depart"))
            if fixture=="territorial" then
                local progression=require "simulation.progression"
                p.run.crew={progression.companion("brindlehorn"),progression.companion("cindercoil"),progression.companion("slatewhorl")}
                p.run.crew[1].stamina=20;p.run.crew[2].stamina=40;p.run.day=18;p.run.terrain="ridge";p.run.weather="rain"
            end
            assert(model.debug(p,"event",fixture=="territorial" and "territorial" or "scavengers"))
            if fixture=="legacy" then
                assert(model.command(p,"choice",{id="battle"}))
                p.run.pending=nil;p.run.return_rng=nil;assert(require("simulation.combat_manual").start(p.run,"scavengers",{1,2}))
            end
            assert(save.write(p))
        end)
    end
    -- Release engines omit console logging; a small report is the durable result.
    local path=sys.get_config_string("trailomon.check_report","engine-check-report.txt")
    local report=assert(io.open(path,"w"))
    report:write(ok and "PASS: native save/load, pending event, battle, result idempotency, backup recovery, corrupt-save handling.\n" or "FAIL: "..tostring(why).."\n")
    report:close()
    if ok then msg.post("#ui","start_checks") else msg.post("@system:","exit",{code=1}) end
end
