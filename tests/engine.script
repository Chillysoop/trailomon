local model=require "simulation.expedition"
local save=require "services.save"

local function run()
    assert(screenshot==nil,"Capture extension leaked into the ordinary game test engine")
    local primary,backup=save.paths()
    -- Refuse to touch anything until the isolated namespace has been verified.
    local namespace=sys.get_config_string("trailomon.save_namespace","")
    assert(namespace=="trailomon_automated_checks" or namespace:match("^trailomon_qa_[a-z]+_%d+$"))
    assert(primary:find(namespace,1,true) and backup:find(namespace,1,true))
    local p=model.new(1848)
    p.settings.travel_speed=nil -- A pre-J4 native save remains readable.
    assert(model.command(p,"depart"))
    assert(model.debug(p,"event","shortcut"))
    local roll=p.run.pending.roll
    assert(save.write(p))
    local loaded=assert(save.load())
    assert(loaded.run.pending.id=="shortcut" and loaded.run.pending.roll==roll)
    assert(loaded.settings.travel_speed==nil)
    assert(model.command(loaded,"settings",{key="travel_speed"}))
    assert(save.write(loaded))
    loaded=assert(save.load());assert(loaded.settings.travel_speed==2)
    assert(model.command(loaded,"choice",{id="risk"}))
    assert(save.write(loaded))
    local file=assert(io.open(primary,"wb"));file:write("corrupt");file:close()
    local recovered,notice=save.load()
    assert(recovered and notice and recovered.run.pending.id=="shortcut")
    assert(save.write(recovered))
    assert(model.command(recovered,"choice",{id="road"}))
    assert(model.debug(recovered,"event","scavengers"))
    assert(model.command(recovered,"choice",{id="battle"}))
    assert(model.command(recovered,"battle_start",{team={1,2}}))
    local target=recovered.run.battle.intent.target
    assert(save.write(recovered))
    local battle=assert(save.load())
    assert(battle.run.battle.intent.target==target and battle.run.battle.round==1)
    local event_roll=battle.run.pending.roll
    assert(model.command(battle,"battle_back"))
    assert(save.write(battle))
    battle=assert(save.load())
    assert(battle.run.mode=="event" and battle.run.pending.roll==event_roll)
    assert(model.command(battle,"choice",{id="battle"}))
    assert(model.command(battle,"battle_start",{team={1,2}}))
    assert(battle.run.battle.intent.target==target)
    assert(model.command(battle,"battle_step"))
    assert(save.write(battle))
    battle=assert(save.load())
    assert(#battle.run.battle.history==1)
    assert(model.command(battle,"withdraw"))
    assert(save.write(battle))
    battle=assert(save.load())
    assert(battle.run.mode=="combat_result" and battle.run.battle.result)
    assert(model.command(battle,"battle_continue"))
    assert(model.command(battle,"return"))
    assert(save.write(battle))
    local ended=assert(save.load())
    assert(ended.run.mode=="result" and #ended.profile.history==1)
    assert(not model.command(ended,"return"))
    local guardian=model.new(1848);assert(model.command(guardian,"depart"))
    assert(model.debug(guardian,"event","guardian_pattern"))
    assert(model.command(guardian,"choice",{id="battle"}))
    assert(save.write(guardian));guardian=assert(save.load())
    assert(guardian.run.pending.pattern==model.combat.GUARDIAN_PATTERN)
    assert(model.command(guardian,"battle_start",{team={1,2}}))
    while guardian.run.mode=="combat" do
        assert(save.write(guardian));guardian=assert(save.load())
        assert(guardian.run.battle.pattern==model.combat.GUARDIAN_PATTERN)
        assert(model.command(guardian,"battle_step"))
    end
    assert(save.write(guardian));guardian=assert(save.load())
    assert(guardian.run.mode=="combat_result")
    for _,path in ipairs({primary,backup}) do
        local f=assert(io.open(path,"wb"));f:write("corrupt");f:close()
    end
    local invalid,warning,blocked=save.load()
    assert(not invalid and warning and blocked)
    os.remove(primary);os.remove(backup)
end
function init(self)
    local ok,why=pcall(run)
    local fixture=sys.get_config_string("trailomon.fixture","")
    if ok and fixture~="" then
        ok,why=pcall(function()
            assert(sys.get_config_string("trailomon.save_namespace",""):match("^trailomon_qa_"),"Fixtures require a separate QA save namespace")
            local p=model.new(1848);assert(model.command(p,"depart"))
            if fixture=="territorial" then
                local progression=require "simulation.progression"
                p.run.crew={progression.companion("brindlehorn"),progression.companion("cindercoil"),progression.companion("slatewhorl")}
                p.run.crew[1].stamina=20;p.run.crew[2].stamina=40;p.run.day=18;p.run.terrain="ridge";p.run.weather="rain"
            end
            assert(model.debug(p,"event",fixture=="territorial" and "territorial" or "scavengers"))
            if fixture=="legacy" then
                assert(model.command(p,"choice",{id="battle"}))
                p.run.pending=nil;p.run.return_rng=nil;assert(require("simulation.combat_manual").start(p.run,"scavengers",{1,2}))
            end
            assert(save.write(p))
        end)
    end
    -- Release engines omit console logging; a small report is the durable result.
    local path=sys.get_config_string("trailomon.check_report","engine-check-report.txt")
    local report=assert(io.open(path,"w"))
    report:write(ok and "PASS: native save/load, pending event, battle, result idempotency, backup recovery, corrupt-save handling.\n" or "FAIL: "..tostring(why).."\n")
    report:close()
    if ok then msg.post("#ui","start_checks") else msg.post("@system:","exit",{code=1}) end
end
